---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Semantic Signal LLM Trader — Autonomous AI Trading Agent with Chart Vision, 768D Vector Memory, and Risk Governance" } = Astro.props;

// Canonical URL: Cloudflare Pages serves directory builds with a trailing slash
// (a request to /story redirects to /story/), so point the canonical at the
// served form instead of the source path.
const rawPath = Astro.url.pathname;
const canonicalPath = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const ogImageUrl = new URL("/og-image.png", Astro.site).href;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			name: "Semantic Signal LLM Trader",
			url: "https://qrak.org/",
			description:
				"Open-source AI trading agent with multimodal chart vision, 768D vector trade memory, and deterministic risk gates. Built by Piotr Kurnicki (@qrak).",
			inLanguage: "en",
			author: {
				"@type": "Person",
				name: "Piotr Kurnicki",
				url: "https://qrak.org/about/",
				sameAs: [
					"https://github.com/qrak",
					"https://discord.gg/ZC48aTTqR2",
					"https://www.buymeacoffee.com/qrak",
				],
			},
		},
		{
			"@type": "SoftwareSourceCode",
			name: "Semantic Signal (LLM_trader)",
			description:
				"Open-source LLM trading agent: 1920×1080 chart vision, 768D vector memory of closed trades, deterministic expected-value entry gate, and a separate CCXT executor service. Trades simulated capital by default.",
			codeRepository: "https://github.com/qrak/LLM_trader",
			programmingLanguage: ["Python", "TypeScript"],
			runtimePlatform: "Python 3.13",
			license: "https://github.com/qrak/LLM_trader/blob/master/LICENSE.md",
			author: { "@type": "Person", name: "Piotr Kurnicki", url: "https://qrak.org/about/" },
			keywords: [
				"LLM trading bot",
				"multimodal chart analysis",
				"vector memory",
				"ChromaDB",
				"Numba",
				"CCXT",
				"expected value",
			],
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Semantic Signal LLM Trader" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="theme-color" content="#0b0f19" />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Machine-readable entry points for LLM tools and crawlers -->
		<link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM index" />
		<link rel="alternate" type="application/json" href="/project.json" title="Project fact sheet" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<header class="navbar">
			<div class="nav-container">
				<a href="/" class="brand">
					<svg class="brand-mark" viewBox="0 0 64 64" width="26" height="26" aria-hidden="true">
						<rect width="64" height="64" rx="12" fill="#0b0f19" stroke="rgba(16,185,129,0.35)" />
						<g stroke="#10b981" stroke-width="6" stroke-linecap="round">
							<line x1="14" y1="30" x2="14" y2="44" />
							<line x1="26" y1="22" x2="26" y2="40" />
							<line x1="38" y1="14" x2="38" y2="34" />
							<line x1="50" y1="26" x2="50" y2="48" />
						</g>
					</svg>
					<span class="brand-text">Semantic Signal</span>
				</a>
				<nav class="nav-links">
					<a href="/">Home</a>
					<a href="/story">Full Story & Tech</a>
					<a href="/articles">Articles</a>
					<a href="/about">About</a>
					<a href="/contact">Contact</a>
					<a href="https://semanticsignal.qrak.org" target="_blank" rel="noopener" class="live-btn">Live dashboard <span class="arrow">↗</span></a>
					<a href="https://github.com/qrak/LLM_trader" target="_blank" rel="noopener" class="github-btn">GitHub <span class="arrow">↗</span></a>
				</nav>
			</div>
		</header>

		<main class="content-wrapper">
			<slot />
		</main>

		<footer class="footer">
			<div class="footer-container">
				<p>© 2026 Semantic Signal by <a href="https://qrak.org" target="_blank">@qrak</a> — built in Wrocław, Poland.</p>
				<div class="footer-links">
					<a href="/about">About</a>
					<a href="/articles">Articles</a>
					<a href="/contact">Contact</a>
					<a href="/privacy-policy">Privacy Policy</a>
					<a href="/disclaimer">Risk Disclaimer</a>
					<a href="https://github.com/qrak/LLM_trader" target="_blank">GitHub</a>
					<a href="https://semanticsignal.qrak.org" target="_blank">Dashboard</a>
					<a href="https://discord.gg/ZC48aTTqR2" target="_blank">Discord</a>
					<a href="https://www.buymeacoffee.com/qrak" target="_blank">Buy Me a Coffee</a>
				</div>
				<p class="stack">
					Python 3.13 · FastAPI · ChromaDB · Numba · CCXT · Astro — <a href="https://github.com/qrak/LLM_trader/tree/master/website" target="_blank" rel="noopener">source of this site</a><br />
					machine-readable: <a href="/llms.txt">/llms.txt</a> · <a href="/llms-full.txt">/llms-full.txt</a> · <a href="/project.json">/project.json</a> · <a href="/sitemap.xml">/sitemap.xml</a> — for AI agents and crawlers; <a href="/robots.txt">crawlers are welcome</a>
				</p>
			</div>
		</footer>

		<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent">
			<p>This site uses essential cookies for delivery and security, and — if you consent — advertising cookies from Google AdSense. <a href="/privacy-policy">Privacy Policy</a></p>
			<div class="cookie-actions">
				<button id="cookie-accept" class="cookie-btn cookie-btn-primary">Accept</button>
				<button id="cookie-decline" class="cookie-btn">Decline</button>
			</div>
		</div>

		<script is:inline>
			(function () {
				var KEY = "ss_cookie_consent";
				var banner = document.getElementById("cookie-banner");
				if (!banner) return;
				if (localStorage.getItem(KEY)) {
					banner.remove();
					return;
				}
				function setConsent(value) {
					try {
						localStorage.setItem(KEY, value);
					} catch (e) {}
					banner.remove();
				}
				var accept = document.getElementById("cookie-accept");
				var decline = document.getElementById("cookie-decline");
				if (accept) accept.addEventListener("click", function () { setConsent("accepted"); });
				if (decline) decline.addEventListener("click", function () { setConsent("declined"); });
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg-main: #0b0f19;
		--bg-card: rgba(17, 24, 39, 0.7);
		--bg-card-hover: rgba(31, 41, 55, 0.8);
		--border-color: rgba(255, 255, 255, 0.08);
		--border-accent: rgba(16, 185, 129, 0.3);
		--text-main: #f3f4f6;
		--text-muted: #9ca3af;
		--text-dim: #6b7280;
		--accent-emerald: #10b981;
		--accent-cyan: #06b6d4;
		--accent-purple: #8b5cf6;
		--code-bg: #111827;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	h1,
	h2,
	h3 {
		letter-spacing: -0.02em;
	}

	body {
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		background-color: var(--bg-main);
		color: var(--text-main);
		line-height: 1.7;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background-image: 
			radial-gradient(circle at 12% 8%, rgba(16, 185, 129, 0.06) 0%, transparent 42%);
	}

	a {
		color: var(--accent-emerald);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: var(--accent-cyan);
	}

	.navbar {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(11, 15, 25, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border-color);
		padding: 1rem 0;
	}

	.nav-container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
		font-size: 1.2rem;
		color: #fff;
	}

	.brand-mark {
		flex: none;
		display: block;
	}

	.arrow {
		font-size: 0.85em;
		opacity: 0.75;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.nav-links a {
		color: var(--text-muted);
		font-size: 0.95rem;
		font-weight: 500;
	}

	.nav-links a:hover {
		color: #fff;
	}

	.live-btn {
		background: rgba(16, 185, 129, 0.15);
		color: var(--accent-emerald) !important;
		border: 1px solid var(--border-accent);
		padding: 0.4rem 0.9rem;
		border-radius: 6px;
		font-size: 0.9rem !important;
		transition: all 0.2s ease !important;
	}

	.live-btn:hover {
		background: rgba(16, 185, 129, 0.25);
		box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
	}

	.github-btn {
		background: rgba(255, 255, 255, 0.05);
		color: #fff !important;
		border: 1px solid var(--border-color);
		padding: 0.4rem 0.9rem;
		border-radius: 6px;
		font-size: 0.9rem !important;
	}

	.content-wrapper {
		flex: 1;
		max-width: 1100px;
		width: 100%;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}

	.footer {
		border-top: 1px solid var(--border-color);
		padding: 2.5rem 0;
		margin-top: 4rem;
		background: rgba(8, 12, 20, 0.6);
	}

	.footer-container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.9rem;
		color: var(--text-dim);
	}

	.footer-links {
		display: flex;
		gap: 1.2rem;
		flex-wrap: wrap;
	}

	.footer-container .stack {
		flex-basis: 100%;
		margin: 0;
		font-family: 'Fira Code', monospace;
		font-size: 0.78rem;
		letter-spacing: 0.01em;
		color: #4b5563;
	}

	.cookie-banner {
		position: fixed;
		bottom: 1rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 200;
		max-width: 720px;
		width: calc(100% - 2rem);
		background: rgba(17, 24, 39, 0.97);
		border: 1px solid var(--border-color);
		border-radius: 10px;
		padding: 1rem 1.25rem;
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: space-between;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.cookie-banner p {
		flex: 1;
		min-width: 240px;
		margin: 0;
	}

	.cookie-actions {
		display: flex;
		gap: 0.6rem;
	}

	.cookie-btn {
		background: rgba(255, 255, 255, 0.06);
		color: var(--text-main);
		border: 1px solid var(--border-color);
		padding: 0.45rem 1.1rem;
		border-radius: 6px;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		font-family: inherit;
		transition: all 0.2s ease;
	}

	.cookie-btn:hover {
		border-color: var(--border-accent);
	}

	.cookie-btn-primary {
		background: var(--accent-emerald);
		color: #0b0f19;
		border-color: var(--accent-emerald);
	}

	.cookie-btn-primary:hover {
		background: #059669;
		color: #0b0f19;
	}

	code {
		font-family: 'Fira Code', monospace;
		background: var(--code-bg);
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
		font-size: 0.9em;
		color: #e5e7eb;
		border: 1px solid var(--border-color);
	}

	pre {
		background: var(--code-bg);
		padding: 1.25rem;
		border-radius: 8px;
		overflow-x: auto;
		border: 1px solid var(--border-color);
		margin: 1.5rem 0;
	}

	pre code {
		background: transparent;
		padding: 0;
		border: none;
	}

	@media (max-width: 768px) {
		.nav-container, .footer-container {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
	}
</style>
