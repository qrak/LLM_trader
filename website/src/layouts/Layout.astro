---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Semantic Signal LLM Trader — Autonomous AI Trading Agent with Chart Vision, 768D Vector Memory, and Risk Governance" } = Astro.props;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Semantic Signal LLM Trader",
	url: "https://qrak.org/",
	description:
		"Open-source AI trading agent with multimodal chart vision, 768D vector trade memory, and deterministic risk gates. Built by Piotr Kurnicki (@qrak).",
	inLanguage: "en",
	author: {
		"@type": "Person",
		name: "Piotr Kurnicki",
		url: "https://qrak.org/about",
		sameAs: [
			"https://github.com/qrak",
			"https://discord.gg/ZC48aTTqR2",
			"https://www.buymeacoffee.com/qrak",
		],
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Semantic Signal LLM Trader" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<header class="navbar">
			<div class="nav-container">
				<a href="/" class="brand">
					<span class="brand-badge">⚡</span>
					<span class="brand-text">Semantic Signal</span>
				</a>
				<nav class="nav-links">
					<a href="/">Home</a>
					<a href="/story">Full Story & Tech</a>
					<a href="/articles">Articles</a>
					<a href="/about">About</a>
					<a href="/contact">Contact</a>
					<a href="https://semanticsignal.qrak.org" target="_blank" class="live-btn">📊 Live Dashboard</a>
					<a href="https://github.com/qrak/LLM_trader" target="_blank" class="github-btn">🐙 GitHub</a>
				</nav>
			</div>
		</header>

		<main class="content-wrapper">
			<slot />
		</main>

		<footer class="footer">
			<div class="footer-container">
				<p>© 2026 Semantic Signal by <a href="https://qrak.org" target="_blank">@qrak</a>. Built with ☕ and no sleep in Wrocław, Poland.</p>
				<div class="footer-links">
					<a href="/about">About</a>
					<a href="/articles">Articles</a>
					<a href="/contact">Contact</a>
					<a href="/privacy-policy">Privacy Policy</a>
					<a href="/disclaimer">Risk Disclaimer</a>
					<a href="https://github.com/qrak/LLM_trader" target="_blank">GitHub</a>
					<a href="https://semanticsignal.qrak.org" target="_blank">Dashboard</a>
					<a href="https://discord.gg/ZC48aTTqR2" target="_blank">Discord</a>
					<a href="https://www.buymeacoffee.com/qrak" target="_blank">Buy Me a Coffee</a>
				</div>
			</div>
		</footer>

		<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent">
			<p>This site uses essential cookies for delivery and security, and — if you consent — advertising cookies from Google AdSense. <a href="/privacy-policy">Privacy Policy</a></p>
			<div class="cookie-actions">
				<button id="cookie-accept" class="cookie-btn cookie-btn-primary">Accept</button>
				<button id="cookie-decline" class="cookie-btn">Decline</button>
			</div>
		</div>

		<script is:inline>
			(function () {
				var KEY = "ss_cookie_consent";
				var banner = document.getElementById("cookie-banner");
				if (!banner) return;
				if (localStorage.getItem(KEY)) {
					banner.remove();
					return;
				}
				function setConsent(value) {
					try {
						localStorage.setItem(KEY, value);
					} catch (e) {}
					banner.remove();
				}
				var accept = document.getElementById("cookie-accept");
				var decline = document.getElementById("cookie-decline");
				if (accept) accept.addEventListener("click", function () { setConsent("accepted"); });
				if (decline) decline.addEventListener("click", function () { setConsent("declined"); });
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg-main: #0b0f19;
		--bg-card: rgba(17, 24, 39, 0.7);
		--bg-card-hover: rgba(31, 41, 55, 0.8);
		--border-color: rgba(255, 255, 255, 0.08);
		--border-accent: rgba(16, 185, 129, 0.3);
		--text-main: #f3f4f6;
		--text-muted: #9ca3af;
		--text-dim: #6b7280;
		--accent-emerald: #10b981;
		--accent-cyan: #06b6d4;
		--accent-purple: #8b5cf6;
		--code-bg: #111827;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		background-color: var(--bg-main);
		color: var(--text-main);
		line-height: 1.7;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background-image: 
			radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.05) 0%, transparent 40%),
			radial-gradient(circle at 85% 85%, rgba(6, 182, 212, 0.05) 0%, transparent 40%);
	}

	a {
		color: var(--accent-emerald);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: var(--accent-cyan);
	}

	.navbar {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(11, 15, 25, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border-color);
		padding: 1rem 0;
	}

	.nav-container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
		font-size: 1.2rem;
		color: #fff;
	}

	.brand-badge {
		font-size: 1.3rem;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.nav-links a {
		color: var(--text-muted);
		font-size: 0.95rem;
		font-weight: 500;
	}

	.nav-links a:hover {
		color: #fff;
	}

	.live-btn {
		background: rgba(16, 185, 129, 0.15);
		color: var(--accent-emerald) !important;
		border: 1px solid var(--border-accent);
		padding: 0.4rem 0.9rem;
		border-radius: 6px;
		font-size: 0.9rem !important;
		transition: all 0.2s ease !important;
	}

	.live-btn:hover {
		background: rgba(16, 185, 129, 0.25);
		box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
	}

	.github-btn {
		background: rgba(255, 255, 255, 0.05);
		color: #fff !important;
		border: 1px solid var(--border-color);
		padding: 0.4rem 0.9rem;
		border-radius: 6px;
		font-size: 0.9rem !important;
	}

	.content-wrapper {
		flex: 1;
		max-width: 1100px;
		width: 100%;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}

	.footer {
		border-top: 1px solid var(--border-color);
		padding: 2.5rem 0;
		margin-top: 4rem;
		background: rgba(8, 12, 20, 0.6);
	}

	.footer-container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.9rem;
		color: var(--text-dim);
	}

	.footer-links {
		display: flex;
		gap: 1.2rem;
		flex-wrap: wrap;
	}

	.cookie-banner {
		position: fixed;
		bottom: 1rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 200;
		max-width: 720px;
		width: calc(100% - 2rem);
		background: rgba(17, 24, 39, 0.97);
		border: 1px solid var(--border-color);
		border-radius: 10px;
		padding: 1rem 1.25rem;
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: space-between;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.cookie-banner p {
		flex: 1;
		min-width: 240px;
		margin: 0;
	}

	.cookie-actions {
		display: flex;
		gap: 0.6rem;
	}

	.cookie-btn {
		background: rgba(255, 255, 255, 0.06);
		color: var(--text-main);
		border: 1px solid var(--border-color);
		padding: 0.45rem 1.1rem;
		border-radius: 6px;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		font-family: inherit;
		transition: all 0.2s ease;
	}

	.cookie-btn:hover {
		border-color: var(--border-accent);
	}

	.cookie-btn-primary {
		background: var(--accent-emerald);
		color: #0b0f19;
		border-color: var(--accent-emerald);
	}

	.cookie-btn-primary:hover {
		background: #059669;
		color: #0b0f19;
	}

	code {
		font-family: 'Fira Code', monospace;
		background: var(--code-bg);
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
		font-size: 0.9em;
		color: #e5e7eb;
		border: 1px solid var(--border-color);
	}

	pre {
		background: var(--code-bg);
		padding: 1.25rem;
		border-radius: 8px;
		overflow-x: auto;
		border: 1px solid var(--border-color);
		margin: 1.5rem 0;
	}

	pre code {
		background: transparent;
		padding: 0;
		border: none;
	}

	@media (max-width: 768px) {
		.nav-container, .footer-container {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
	}
</style>
