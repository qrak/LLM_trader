# keys.env.example - OPTIONAL secrets file, not the public config.ini settings.
# Recommended: set only the variables you need in your OS / service environment.
# This avoids a second plaintext copy of secrets inside the project directory.
# The bot also supports a local keys.env: copy this file to keys.env if preferred.
# keys.env is gitignored. Never commit it, print secrets or put them in config.ini.
# Environment variables are not encrypted: protect the account/service and avoid
# exposing them in logs, shell history or shared process inspection tools.
#
# Precedence: process environment > keys.env. An explicitly empty environment
# variable also overrides the file. Restart the bot after changing either source;
# on Windows, reopen the launcher terminal after changing persistent OS variables.
#
# Choose [ai_providers] provider in config/config.ini, then supply ONLY its key:
#   deepseek   -> DEEPSEEK_API_KEY
#   openrouter -> OPENROUTER_API_KEY (even for Google/DeepSeek models on OpenRouter;
#                 their direct-provider keys are NOT needed)
#   googleai   -> GOOGLE_STUDIO_API_KEY
#   local      -> no cloud API keys (configure LM Studio in config.ini)
#   all        -> keys only for the fallback providers you want to enable;
#                 providers without credentials are skipped
# A missing key for the selected cloud provider prevents it from serving calls;
# keys for unrelated providers are NOT required. Leave them empty or remove them.
# No keys.env file is needed when the required variables are in the environment.

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_STUDIO_API_KEY=
# Optional Google paid-tier fallback; only useful with the Google client enabled.
GOOGLE_STUDIO_PAID_API_KEY=

# Discord: needed only when [general] discord_bot = true in config.ini.
BOT_TOKEN_DISCORD=
MAIN_CHANNEL_ID=

# Optional CoinGecko key for higher rate limits; public access works without it.
COINGECKO_API_KEY=
# Optional Hugging Face token for authenticated downloads / higher rate limits.
HF_TOKEN=

# Optional web dashboard /admin login; not needed for the bot's trading analysis.
# Leave credentials empty to keep admin login unavailable.
# Generate hash: python -c "from src.dashboard.auth import hash_password; print(hash_password('your_password'))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional session-cookie signing key; empty = auto-generated.
ADMIN_SIGNING_KEY=

# Optional BlockRun fallback in provider = all (Base wallet for x402 payments).
# Used only for local signing. Use a dedicated wallet with minimal funds.
# Never commit the private key. Leave empty to disable the client.
BLOCKRUN_WALLET_KEY=
